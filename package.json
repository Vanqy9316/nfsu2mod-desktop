{
  "name": "nfsu2desktop",
  "productName": "Underground 2 Revived",
  "version": "1.1.5",
  "description": "Desktop client for Need for Speed: Underground 2 (nfsu2mod.xyz)",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/DJTOMATO/nfsu2desktop.git"
  },
  "homepage": "https://github.com/DJTOMATO/nfsu2desktop#readme",
  "bugs": {
    "url": "https://github.com/DJTOMATO/nfsu2desktop/issues"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/lenabot"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:win:arm64": "electron-builder --win --arm64 --config.nsis.oneClick=false --config.nsis.allowToChangeInstallationDirectory=true --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "electron",
    "nfsu2",
    "need-for-speed-underground-2",
    "racing",
    "webassembly",
    "webgpu"
  ],
  "author": "Glas",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.glas.nfsu2desktop",
    "productName": "Underground 2 Revived",
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Underground 2 Revived",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Game",
      "maintainer": "Glas <48269777+DJTOMATO@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "nfsu2mod.js",
      "index.html",
      "node_modules/**/*",
      "icon.ico",
      "icon.png",
      "icon.icns"
    ]
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}
